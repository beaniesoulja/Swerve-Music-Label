# Public configuration. SITE_URL must be the verified canonical HTTPS origin.
SITE_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_TIKTOK_URL=
SOCIAL_YOUTUBE_URL=
# Publish only approved policy documents, then add their HTTPS URLs.
PRIVACY_POLICY_URL=
TERMS_URL=

# Set true only after verifying mail delivery to these actual mailboxes/aliases.
CONTACT_EMAIL_ENABLED=true
CONTACT_ARTISTS_EMAIL=hello@swervemusic.org
CONTACT_BOOKINGS_EMAIL=hello@swervemusic.org
CONTACT_CULTURE_EMAIL=hello@swervemusic.org

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=
# Generate at least 32 random characters. Keep stable to preserve unsubscribe links.
NEWSLETTER_TOKEN_SECRET=
# Enable only after migration, verified sender, approved policy, and end-to-end test.
NEWSLETTER_ENABLED=false
# Optional. Use only a client-IP header your hosting proxy overwrites.
# e.g. cf-connecting-ip on Cloudflare, x-vercel-forwarded-for on Vercel.
TRUSTED_CLIENT_IP_HEADER=
