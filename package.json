{
  "name": "swerve-music-label-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --import tsx --test tests/newsletter.test.mjs tests/preview-volume.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "newsletter:export": "node --import tsx scripts/export-newsletter.ts",
    "images:optimize": "node scripts/optimize-artist-images.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "drizzle-orm": "0.45.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "nitro": "^3.0.260903-beta",
    "react-server-dom-webpack": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.1",
    "vite": "8.3.3",
    "wrangler": "4.148.0"
  },
  "type": "module",
  "overrides": {
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.5": true,
    "workerd@1.20261006.1": true
  }
}
